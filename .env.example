# Ingestor configuration — copy to .env and edit. All optional: the defaults are
# open-source and need no keys. Override any line to swap in your own model/API.

# --- Embeddings ---------------------------------------------------------------
# Provider: sentence-transformers (default, local) | hashing (zero-dep fallback)
#           | openai | voyage  (API providers — add the client in providers.py)
INGESTOR_EMBEDDING_PROVIDER=sentence-transformers
# Model name for the local provider:
INGESTOR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- OCR ----------------------------------------------------------------------
# Provider: tesseract (default, local binary) | none
INGESTOR_OCR_PROVIDER=tesseract

# --- API keys (only used if you select the matching provider above) -----------
# OPENAI_API_KEY=
# VOYAGE_API_KEY=
